// =====================================================
// NEC TRANSMITTER
// =====================================================

void mark(uint16_t us) {
digitalWrite(SIGNAL_PIN, LOW);
delayMicroseconds(us);
}

void space(uint16_t us) {
digitalWrite(SIGNAL_PIN, HIGH);
delayMicroseconds(us);
}

void sendNEC(uint16_t address, uint8_t command) {

uint32_t data =
(uint32_t)address |
((uint32_t)command << 16) |
((uint32_t)(~command & 0xFF) << 24);

// 9 ms header
mark(9000);

// 4.5 ms space
space(4500);

// 32 bits, LSB first
for (int i = 0; i < 32; i++) {

mark(560);  

if (data & 0x01) {  
  space(1690);  
} else {  
  space(560);  
}  

data >>= 1;

}

// Final mark
mark(560);

// Idle HIGH
digitalWrite(SIGNAL_PIN, HIGH);
}

// =====================================================
// SEND COMMAND
// =====================================================

void sendCommand(uint8_t command) {

const uint16_t ADDRESS = 0xEF00;

sendNEC(ADDRESS, command);

delay(40);

sendNEC(ADDRESS, command);
}

